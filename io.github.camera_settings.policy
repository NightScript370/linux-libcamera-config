<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="io.github.camera_settings.apply">
    <description>Change the built-in camera's picture settings</description>
    <message>Authentication is required to change the camera settings</message>
    <icon_name>camera-web</icon_name>
    <defaults>
      <!-- The helper only accepts numbers in fixed ranges, so the person at the
           computer may use it without a password. -->
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/camera-settings-apply</annotate>
  </action>
</policyconfig>
